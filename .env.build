# iOS Build Environment Variables
# Copy this file to .env.build and fill in your values
# Usage: source .env.build && ./build-ios.sh

# Xcode workspace name (found in ios/ directory)
export WORKSPACE_NAME="allrounderbaby.xcworkspace"

# Xcode scheme name (usually matches your app name)
export SCHEME_NAME="allrounderbaby"

# Apple Developer Team ID (10-character string)
# Find it at: https://developer.apple.com/account/#/membership
export TEAM_ID="sJ7N3XD6F83"

# Path to ExportOptions.plist file
export EXPORT_OPTIONS_PLIST="./ExportOptions.plist"

# Build configuration (optional, defaults to "Release")
export CONFIGURATION="Release"

# Skip pod install if needed (optional, defaults to "false")
# export SKIP_POD_INSTALL="false"
